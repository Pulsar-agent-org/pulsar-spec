# pulsar-spec ships prose and JSON test vectors. It has no runtime service and
# needs no secrets to build or to run the conformance runner.
#
# These variables are documented here because the conformance vectors and the
# worked example in spec/protocol.md reference a Stellar Testnet configuration.
# An implementation under test (for example pulsar-js) reads values like these.
# Never point any of these at Stellar mainnet while running conformance vectors.

# Horizon endpoint used to resolve payment transactions.
HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase. Testnet only for v0.1.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Asset the worked example prices in. CODE:ISSUER for a credit asset, or XLM.
PULSAR_ASSET=USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Never commit a funded secret key. Fund test accounts through friendbot:
# https://friendbot.stellar.org/?addr=<G...>
